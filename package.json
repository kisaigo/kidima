{
  "name": "kidima",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "app": "npm run start --workspace apps/app",
    "app:web": "npm run web --workspace apps/app",
    "lint:app": "npm run lint --workspace apps/app",
    "typecheck:app": "npm exec --workspace apps/app -- tsc --noEmit",
    "export:web": "npm exec --workspace apps/app -- expo export --platform web"
  }
}
