{
  "name": "kidima",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "mobile:web": "npm run web --workspace apps/mobile",
    "lint:mobile": "npm run lint --workspace apps/mobile",
    "typecheck:mobile": "npm exec --workspace apps/mobile -- tsc --noEmit",
    "export:web": "npm exec --workspace apps/mobile -- expo export --platform web"
  }
}
